#!/usr/bin/env bash
# Hook entry for Claude Code. Exits before starting Node unless this session has a Planet marker
# or is named as the owner of a PR in some phase file and fired a prompt.
input="$(cat)"
sid="$(printf '%s' "$input" | grep -o '"session_id": *"[^"]*"' | head -1 | sed 's/.*: *"\(.*\)"/\1/')"
home="${PLANET_HOME:-$HOME/.planet}"
if [ -z "$sid" ]; then
  exit 0
fi
if [ ! -f "$home/sessions/$sid" ]; then
  # Only phase files hold PR links with their owning session. nullglob keeps a missing epics dir quiet.
  shopt -s nullglob
  phase_files=("$home"/epics/*/phases/*.md)
  shopt -u nullglob
  if [ "${#phase_files[@]}" -eq 0 ] || ! grep -qsF -- "$sid" "${phase_files[@]}"; then
    exit 0
  fi
  event="$(printf '%s' "$input" | grep -o '"hook_event_name": *"[^"]*"' | head -1 | sed 's/.*: *"\(.*\)"/\1/')"
  if [ "$event" != "UserPromptSubmit" ]; then
    exit 0
  fi
fi
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do self="$(readlink "$self")"; done
root="$(cd "$(dirname "$self")/.." && pwd)"
. "$root/cli/find-node.sh"
node_bin="$(planet_find_node)" || { printf '%s node not found; set PLANET_NODE\n' "$(date -u +%FT%TZ)" >> "$home/hook.log"; exit 0; }
printf '%s' "$input" | "$node_bin" "$root/cli/planet.ts" capture 2>>"$home/hook.log" || true
exit 0
